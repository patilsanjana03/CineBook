<UserControl x:Class="CineBook.Desktop.Views.MoviesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: all movies -->
        <Border Grid.Column="0" Style="{StaticResource CardBorder}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Now showing" FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,12"/>
                <ListBox ItemsSource="{Binding Movies}" SelectedItem="{Binding SelectedMovie}"
                         BorderThickness="0" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,6">
                                <TextBlock Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" FontSize="15"/>
                                <TextBlock Foreground="{StaticResource MutedBrush}">
                                    <Run Text="{Binding Genre, Mode=OneWay}"/>
                                    <Run Text="  •  "/>
                                    <Run Text="{Binding DurationMinutes, Mode=OneWay}"/>
                                    <Run Text=" min"/>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Right: details and showtimes of the selected movie -->
        <Border Grid.Column="2" Style="{StaticResource CardBorder}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="{Binding SelectedMovie.Title}" FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding SelectedMovie.Description}" TextWrapping="Wrap"
                               Foreground="{StaticResource MutedBrush}" Margin="0,8,0,20"/>
                    <TextBlock Text="Showtimes" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,8"/>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Shows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E3E7ED" BorderThickness="0,0,0,1" Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="15"
                                                   Text="{Binding StartsAt, StringFormat='ddd, dd MMM  •  hh:mm tt'}"/>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="15"
                                                   FontWeight="SemiBold" Margin="0,0,20,0"
                                                   Text="{Binding Price, StringFormat='₹{0:N0}'}"/>

                                        <!-- Inside a list item, the command lives on the parent view model,
                                             so we reach up to the UserControl's DataContext to find it. -->
                                        <Button Grid.Column="2" Content="Select seats" Style="{StaticResource PrimaryButton}"
                                                Command="{Binding DataContext.SelectShowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
