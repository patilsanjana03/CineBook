<UserControl x:Class="CineBook.Desktop.Views.SeatSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>

        <!-- A seat is a ToggleButton: unchecked = free, checked = picked by you,
             disabled = already booked by someone else. -->
        <Style x:Key="SeatStyle" TargetType="ToggleButton">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="#DDE6F0"/>
            <Setter Property="Foreground" Value="#1F3A5F"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8,8,3,3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2E86AB"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#C9CDD3"/>
                                <Setter Property="Foreground" Value="#7C8590"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Margin="24">
        <Border Style="{StaticResource CardBorder}">
            <DockPanel>

                <!-- Top: back button and show title -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Left" Content="←  Back" Command="{Binding BackCommand}"
                            Style="{StaticResource GhostButton}" VerticalAlignment="Center"/>
                    <StackPanel Margin="16,0,0,0">
                        <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}"/>
                        <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                </DockPanel>

                <!-- Bottom: summary and confirm button (declared before the fill area on purpose,
                     because a DockPanel gives the last child whatever space is left). -->
                <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedSummary}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Button Grid.Column="1" Content="Confirm booking" Command="{Binding ConfirmCommand}"
                            Style="{StaticResource PrimaryButton}"/>
                </Grid>

                <!-- Middle: screen, seats and legend -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel HorizontalAlignment="Center" Margin="0,16,0,0">

                        <Border Width="440" Height="8" CornerRadius="4" Background="{StaticResource AccentBrush}"/>
                        <TextBlock Text="SCREEN" HorizontalAlignment="Center" FontSize="11"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>

                        <ItemsControl ItemsSource="{Binding Seats}" Width="480" Margin="0,24,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <!-- Columns comes from the view model, so any hall size works. -->
                                    <UniformGrid Columns="{Binding DataContext.SeatsPerRow, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ToggleButton Style="{StaticResource SeatStyle}" Content="{Binding Label}"
                                                  IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsAvailable}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                            <Border Width="16" Height="16" CornerRadius="4" Background="#DDE6F0"/>
                            <TextBlock Text="Free" Margin="6,0,20,0" Foreground="{StaticResource MutedBrush}"/>
                            <Border Width="16" Height="16" CornerRadius="4" Background="#2E86AB"/>
                            <TextBlock Text="Your pick" Margin="6,0,20,0" Foreground="{StaticResource MutedBrush}"/>
                            <Border Width="16" Height="16" CornerRadius="4" Background="#C9CDD3"/>
                            <TextBlock Text="Taken" Margin="6,0,0,0" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

            </DockPanel>
        </Border>
    </Grid>
</UserControl>
