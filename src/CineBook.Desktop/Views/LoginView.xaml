<UserControl x:Class="CineBook.Desktop.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Border Style="{StaticResource CardBorder}" Width="400" Padding="32"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="CineBook" FontSize="32" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,24"/>

                <!-- Only shown while creating an account. -->
                <StackPanel Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="FULL NAME" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}"/>
                </StackPanel>

                <TextBlock Text="EMAIL" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}"/>

                <TextBlock Text="PASSWORD" Style="{StaticResource FieldLabel}"/>
                <PasswordBox x:Name="PasswordInput" Style="{StaticResource InputPassword}"
                             PasswordChanged="PasswordInput_PasswordChanged"/>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}"
                           TextWrapping="Wrap" Margin="0,0,0,12"/>

                <!-- IsDefault means pressing Enter clicks this button. -->
                <Button Content="{Binding SubmitText}" Command="{Binding SubmitCommand}"
                        Style="{StaticResource PrimaryButton}" IsDefault="True"/>

                <Button Content="{Binding ToggleText}" Command="{Binding ToggleModeCommand}"
                        Style="{StaticResource GhostButton}" Margin="0,10,0,0"/>

                <TextBlock Text="Demo login: user@cinebook.com / User@123" FontSize="12"
                           Foreground="{StaticResource MutedBrush}" Margin="0,18,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
