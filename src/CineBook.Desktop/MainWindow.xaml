<Window x:Class="CineBook.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CineBook.Desktop.ViewModels"
        xmlns:views="clr-namespace:CineBook.Desktop.Views"
        Title="CineBook" Height="700" Width="1040" MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI"
        Background="{StaticResource BackgroundBrush}">

    <!-- This is the heart of the navigation: whenever CurrentViewModel changes,
         WPF looks here to find which screen matches that view model. -->
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:LoginViewModel}">
            <views:LoginView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MoviesViewModel}">
            <views:MoviesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SeatSelectionViewModel}">
            <views:SeatSelectionView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MyBookingsViewModel}">
            <views:MyBookingsView/>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- Top bar only appears after login. -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PrimaryBrush}" Padding="24,12"
                Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="{Binding Greeting}" Foreground="White" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <Button Content="Movies" Command="{Binding ShowMoviesCommand}" Style="{StaticResource HeaderButton}" Margin="0,0,8,0"/>
                    <Button Content="My bookings" Command="{Binding ShowBookingsCommand}" Style="{StaticResource HeaderButton}" Margin="0,0,8,0"/>
                    <Button Content="Log out" Command="{Binding LogoutCommand}" Style="{StaticResource HeaderButton}"/>
                </StackPanel>
                <TextBlock Text="CineBook" Foreground="White" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <ContentControl Content="{Binding CurrentViewModel}"/>
    </DockPanel>
</Window>
